<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    This macro creates one tool attached to a UR5e flange frame.

    The STL was exported with its own baked-in offset.
    We compensate for that inside the mesh origin.
  -->

  <xacro:macro name="probe_tool" params="parent_link">

    <xacro:property name="pump" value="${xacro.load_yaml('$(find ur5e_toolheads)/config/printing_tool.yaml')}"/>
    <xacro:if value="${pump['enabled']}">
      <link name="probe_tool_link">
        <visual>
          <origin xyz="${'%s %s %s' % (pump['mesh_xyz'][0], pump['mesh_xyz'][1], pump['mesh_xyz'][2])}" rpy="${'%s %s %s' % (pump['mesh_rpy'][0], pump['mesh_rpy'][1], pump['mesh_rpy'][2])}"/>
          <geometry><mesh filename="package://ur5e_toolheads/meshes/Full_UR_Syringe_Pump.stl" scale="${'%s %s %s' % (pump['mesh_scale'][0], pump['mesh_scale'][1], pump['mesh_scale'][2])}"/></geometry>
          <material name="pump_gray"><color rgba="0.55 0.6 0.65 1"/></material>
        </visual>
        <xacro:unless value="${pump.get('coarse_collision', False)}">
        <collision>
          <origin xyz="${'%s %s %s' % (pump['mesh_xyz'][0], pump['mesh_xyz'][1], pump['mesh_xyz'][2])}" rpy="${'%s %s %s' % (pump['mesh_rpy'][0], pump['mesh_rpy'][1], pump['mesh_rpy'][2])}"/>
          <geometry><mesh filename="package://ur5e_toolheads/meshes/Full_UR_Syringe_Pump.stl" scale="${'%s %s %s' % (pump['mesh_scale'][0], pump['mesh_scale'][1], pump['mesh_scale'][2])}"/></geometry>
        </collision>
        </xacro:unless>
      </link>
      <!-- Conservative envelopes in original CAD coordinates. Visual and TCP unchanged. -->
      <xacro:if value="${pump.get('coarse_collision', False)}">
        <link name="pump_sleeve_envelope">
          <collision>
            <origin xyz="0 ${1079.4*pump['mesh_scale'][1]} ${205.4*pump['mesh_scale'][2]}"/>
            <geometry><cylinder radius="${53.0*max(pump['mesh_scale'][0],pump['mesh_scale'][1])}" length="${62.0*pump['mesh_scale'][2]}"/></geometry>
          </collision>
        </link>
        <link name="pump_body_envelope">
          <collision>
            <!--
              The sleeve owns the flange-adjacent region out to CAD X=53 mm.
              Start the checked body at that boundary so its conservative box
              cannot permanently overlap wrist_2 through the sleeve.  The far
              face remains at the STL bound X=125.25 mm.
            -->
            <origin xyz="${89.125*pump['mesh_scale'][0]} ${1081.41265*pump['mesh_scale'][1]} ${173.7*pump['mesh_scale'][2]}"/>
            <geometry><box size="${72.25*pump['mesh_scale'][0]} ${43.0251*pump['mesh_scale'][1]} ${203.6*pump['mesh_scale'][2]}"/></geometry>
          </collision>
        </link>
        <!-- Tighter primitives follow the STL near the TCP. -->
        <link name="pump_tip_stem_envelope">
          <collision>
            <origin xyz="${87.65*pump['mesh_scale'][0]} ${1083.25*pump['mesh_scale'][1]} ${293.6*pump['mesh_scale'][2]}"/>
            <geometry><box size="${3.9*pump['mesh_scale'][0]} ${12.3*pump['mesh_scale'][1]} ${34.6*pump['mesh_scale'][2]}"/></geometry>
          </collision>
        </link>
        <link name="pump_tip_collar_envelope">
          <collision>
            <origin xyz="${96.74983*pump['mesh_scale'][0]} ${1081.4002*pump['mesh_scale'][1]} ${313.05*pump['mesh_scale'][2]}"/>
            <geometry><cylinder radius="${11.0*max(pump['mesh_scale'][0],pump['mesh_scale'][1])}" length="${4.5*pump['mesh_scale'][2]}"/></geometry>
          </collision>
        </link>
        <link name="pump_nozzle_envelope">
          <collision>
            <origin xyz="${96.74983*pump['mesh_scale'][0]} ${1081.4002*pump['mesh_scale'][1]} ${319.25*pump['mesh_scale'][2]}"/>
            <geometry><cylinder radius="${5.0*max(pump['mesh_scale'][0],pump['mesh_scale'][1])}" length="${8.5*pump['mesh_scale'][2]}"/></geometry>
          </collision>
        </link>
        <link name="pump_outlet_envelope">
          <collision>
            <origin xyz="${96.74983*pump['mesh_scale'][0]} ${1081.4002*pump['mesh_scale'][1]} ${324.55*pump['mesh_scale'][2]}"/>
            <geometry><cylinder radius="${2.2*max(pump['mesh_scale'][0],pump['mesh_scale'][1])}" length="${3.0*pump['mesh_scale'][2]}"/></geometry>
          </collision>
        </link>
        <joint name="tool_to_sleeve_envelope" type="fixed">
          <parent link="probe_tool_link"/><child link="pump_sleeve_envelope"/>
          <origin xyz="${'%s %s %s' % (pump['mesh_xyz'][0], pump['mesh_xyz'][1], pump['mesh_xyz'][2])}" rpy="${'%s %s %s' % (pump['mesh_rpy'][0], pump['mesh_rpy'][1], pump['mesh_rpy'][2])}"/>
        </joint>
        <joint name="tool_to_body_envelope" type="fixed">
          <parent link="probe_tool_link"/><child link="pump_body_envelope"/>
          <origin xyz="${'%s %s %s' % (pump['mesh_xyz'][0], pump['mesh_xyz'][1], pump['mesh_xyz'][2])}" rpy="${'%s %s %s' % (pump['mesh_rpy'][0], pump['mesh_rpy'][1], pump['mesh_rpy'][2])}"/>
        </joint>
        <joint name="tool_to_tip_stem_envelope" type="fixed">
          <parent link="probe_tool_link"/><child link="pump_tip_stem_envelope"/>
          <origin xyz="${'%s %s %s' % (pump['mesh_xyz'][0], pump['mesh_xyz'][1], pump['mesh_xyz'][2])}" rpy="${'%s %s %s' % (pump['mesh_rpy'][0], pump['mesh_rpy'][1], pump['mesh_rpy'][2])}"/>
        </joint>
        <joint name="tool_to_tip_collar_envelope" type="fixed">
          <parent link="probe_tool_link"/><child link="pump_tip_collar_envelope"/>
          <origin xyz="${'%s %s %s' % (pump['mesh_xyz'][0], pump['mesh_xyz'][1], pump['mesh_xyz'][2])}" rpy="${'%s %s %s' % (pump['mesh_rpy'][0], pump['mesh_rpy'][1], pump['mesh_rpy'][2])}"/>
        </joint>
        <joint name="tool_to_nozzle_envelope" type="fixed">
          <parent link="probe_tool_link"/><child link="pump_nozzle_envelope"/>
          <origin xyz="${'%s %s %s' % (pump['mesh_xyz'][0], pump['mesh_xyz'][1], pump['mesh_xyz'][2])}" rpy="${'%s %s %s' % (pump['mesh_rpy'][0], pump['mesh_rpy'][1], pump['mesh_rpy'][2])}"/>
        </joint>
        <joint name="tool_to_outlet_envelope" type="fixed">
          <parent link="probe_tool_link"/><child link="pump_outlet_envelope"/>
          <origin xyz="${'%s %s %s' % (pump['mesh_xyz'][0], pump['mesh_xyz'][1], pump['mesh_xyz'][2])}" rpy="${'%s %s %s' % (pump['mesh_rpy'][0], pump['mesh_rpy'][1], pump['mesh_rpy'][2])}"/>
        </joint>
      </xacro:if>
      <joint name="flange_to_probe_tool" type="fixed">
        <parent link="${parent_link}"/><child link="probe_tool_link"/>
        <origin xyz="${'%s %s %s' % (pump['mount_xyz'][0], pump['mount_xyz'][1], pump['mount_xyz'][2])}" rpy="${'%s %s %s' % (pump['mount_rpy'][0], pump['mount_rpy'][1], pump['mount_rpy'][2])}"/>
      </joint>
      <link name="probe_tcp"/>
      <joint name="probe_tool_to_tcp" type="fixed">
        <parent link="probe_tool_link"/><child link="probe_tcp"/>
        <origin xyz="${'%s %s %s' % (pump['tcp_xyz'][0], pump['tcp_xyz'][1], pump['tcp_xyz'][2])}" rpy="${'%s %s %s' % (pump['tcp_rpy'][0], pump['tcp_rpy'][1], pump['tcp_rpy'][2])}"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${pump['enabled']}">
    <link name="probe_tool_link">

      <visual>
        <!-- STL offset in METERS -->
        <origin xyz="0 -1.0794 -0.227868" rpy="0 0 0"/>

        <geometry>
          <mesh
            filename="package://ur5e_toolheads/meshes/e-Series_UR5e_Probe.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>

        <material name="probe_gray">
          <color rgba="0.35 0.35 0.35 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 -1.0794 -0.227868" rpy="0 0 0"/>

        <geometry>
          <mesh
            filename="package://ur5e_toolheads/meshes/e-Series_UR5e_Probe.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

    </link>

    <!-- Attach the logical tool frame to the UR5e physical flange -->
    <joint name="flange_to_probe_tool" type="fixed">
      <parent link="${parent_link}"/>
      <child link="probe_tool_link"/>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
    </joint>

    <!-- First approximate TCP. We refine this after RViz verification. -->
    <link name="probe_tcp"/>

    <joint name="probe_tool_to_tcp" type="fixed">
      <parent link="probe_tool_link"/>
      <child link="probe_tcp"/>
      <origin xyz="0 0 0.050032" rpy="0 0 0"/>
    </joint>

    </xacro:unless>
    <link name="nozzle_tcp"/>
    <joint name="probe_tcp_to_nozzle_tcp" type="fixed">
      <parent link="probe_tcp"/><child link="nozzle_tcp"/>
    </joint>

  </xacro:macro>
</robot>
