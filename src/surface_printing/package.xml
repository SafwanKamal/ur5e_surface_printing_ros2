<?xml version="1.0"?>
<package format="3">
  <name>surface_printing</name>
  <version>0.1.0</version>
  <description>Cartesian surface planning and coordinated syringe execution.</description>

  <maintainer email="maintainer@example.com">Safwan Kamal</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>ur5e_toolheads</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>syringe_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>python3-numpy</exec_depend>
</package>

